# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Postgres (Supabase -> Project Settings -> Database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/upnotes
DIRECT_URL=postgresql://postgres:password@localhost:5432/upnotes

# Server-only: lets admins delete other users files from Storage. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
