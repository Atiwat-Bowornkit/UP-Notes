
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Postgres (Supabase -> Connect -> Direct tab)
# DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true   -> used by the running app
# DIRECT_URL   = Session pooler (port 5432)                          -> used by prisma db push/migrate
#   (the "Direct connection" host db.<ref>.supabase.co is IPv6-only and fails on IPv4 networks)
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Server-only: lets admins delete other users files from Storage. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
