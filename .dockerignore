# Dockerignore for UP-Notes Project

# Dependencies & Build artifacts
node_modules
.next
dist
build

# Environment files & Secrets (CRITICAL SECURITY)
.env
.env.*
.env.local
*.pem
*.key

# Version Control & Git
.git
.gitignore

# IDE & OS System files
.vscode
.idea
.DS_Store
Thumbs.db

# Test & Coverage files
tests/
coverage/
__pycache__/
*.pyc

# Logs & Temporary files
*.log
npm-debug.log*
yarn-debug.log*

# Documentation & Lab files (Reduce Image Size)
Lab*.md
docs/
