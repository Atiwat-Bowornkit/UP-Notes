{
  "name": "up-notes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "npx --yes eslint@9 src modules tests",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.js",
    "test:mutation": "stryker run",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:make-admin": "dotenv -e .env.local -- node prisma/make-admin.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^14.2.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "dotenv-cli": "^11.0.0",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.28",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.3.8"
  }
}
