{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "mutate": [
    "src/fizzbuzz.js",
    "src/utils/notesHelper.js"
  ],
  "testRunner": "command",
